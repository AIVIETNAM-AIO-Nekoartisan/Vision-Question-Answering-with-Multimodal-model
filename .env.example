# Copy to .env and fill in. .env is gitignored.
# The OCR keys are Vertex AI Express keys; gemini-2.0-flash 404s for them,
# gemini-2.5-flash answers. See docs/ENVIRONMENT.md.

# API keys copied from /mnt/data/AIC_2025-main/.env on 2026-10-04
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
# ... up to GOOGLE_API_KEY_30. MultiLLMOCR rotates across them;
# one key is enough to run, just slower.

# --- Data stores ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=videomme_keyframes
ES_HOST=localhost
ES_PORT=9200
ES_ASR_INDEX=asr_data
ES_OCR_INDEX=ocr_data

# --- Paths (repo lives on / with only 18GB free; data must stay on Lexar) ---
DATA_ROOT=/media/nekoartisan/Lexar/vqa-data
HF_HOME=/mnt/data/vqa-hf
VIDEO_DIRS=/media/nekoartisan/Lexar/vqa-data/videos

# --- Models ---
# Local dir: the hub id is unreachable here, and this copy is complete
# (4,544,143,072 bytes), so no download and no 4.5GB duplicate.
SIGLIP_MODEL=/mnt/data/aic25-clean-models/siglip
JINA_MODEL=jinaai/jina-clip-v2
# Local directory, not a hub id: hf download cannot complete on this network,
# so scripts/fetch_model_curl.sh pulls the repo with curl instead.
QWEN_VL_MODEL=/mnt/data/vqa-models/qwen2.5-vl-3b
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=en

# --- Retrieval (see spec section 7) ---
CANDIDATE_DEPTH=50
RRF_K=60
TOP_K=10
W_SIGLIP=1.0
W_JINA=1.0
W_ASR=0.8
W_OCR=0.5
ASR_SOURCE=subtitle

# --- Serving ---
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Filesystem split (discovered 2026-10-04) ---
# Lexar is exFAT: no POSIX permissions, no symlinks, no Lucene-compatible file
# locking. Videos and keyframes live there (plain file reads are fine), but
# Elasticsearch data, Qdrant storage and HF_HOME must sit on ext4.
QDRANT_STORAGE=/mnt/data/vqa-stores/qdrant
ES_STORAGE=/mnt/data/vqa-stores/es
TRANSNET_WEIGHTS=/mnt/data/AIC_2025-main/model_weights/transnetv2-pytorch-weights.pth
ANNOTATIONS_DIR=/media/nekoartisan/Lexar/vqa-data/annotations

# Fail fast instead of hanging ~18min trying to fetch uncached weights.
HF_HUB_OFFLINE=1

# gemini-2.0-flash returns 404 for these keys: they are Vertex AI Express keys
# bound to project 26275598820 / asia-southeast1. gemini-2.5-flash answers.
OCR_MODEL=gemini-2.5-flash
